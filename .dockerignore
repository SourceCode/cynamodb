# Build output — a host-generated build/ carries a CMakeCache.txt pinned to the host's absolute
# source path, which makes the in-container `cmake -S . -B build` fail with a cache/source mismatch.
# It's also large (hundreds of MB), so excluding it keeps the build context small and fast.
build/
cmake-build-*/
out/

# Version control + CI metadata (not needed to compile)
.git/
.github/
.gitignore

# Editor / OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local logs / scratch
*.log
